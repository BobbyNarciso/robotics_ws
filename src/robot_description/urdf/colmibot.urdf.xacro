<?xml version="1.0"?>
<!--
  Convertido desde el export de SolidWorks (CLM-EnsambleColmibot).

  Convenciones (REP-103): base_link con x adelante, y izquierda, z arriba.
  Origen de base_link = origen de SolidWorks (centro entre ruedas, a nivel de la base).
  El suelo queda en z = -0.0135 m (parte baja de las ruedas).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="colmibot">

  <!-- Para RViz solo: use_gazebo:=false -->
  <xacro:arg name="use_gazebo" default="true"/>

  <!-- Dimensiones CAD -->
  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:property name="wheel_y" value="0.087"/>
  <xacro:property name="wheel_z" value="0.0165"/>
  <xacro:property name="wheel_separation" value="${2*wheel_y}"/>
  <xacro:property name="caster_x" value="0.08"/>
  <xacro:property name="caster_radius" value="0.0135"/>
  <xacro:property name="PI" value="3.14159265359"/>

  <material name="gris"><color rgba="0.3 0.3 0.3 1"/></material>
  <material name="negro"><color rgba="0.08 0.08 0.08 1"/></material>

  <xacro:property name="body_yaw" value="1.5"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${body_yaw}"/>
  </joint>

  <!-- ===================== CUERPO ===================== -->
  <link name="base_link">
    <inertial>
      <!-- Centro de masa e inercia del CAD, rotados al marco base_link -->
      <origin xyz="-0.0053112 0.00035325 0.047942" rpy="0 0 0"/>
      <mass value="0.93582"/>
      <inertia ixx="0.0011494" ixy="-2.4863e-06" ixz="1.2675e-06"
               iyy="0.0011063" iyz="5.497e-07" izz="0.0021693"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.stl"/>
      </geometry>
      <material name="gris"/>
    </visual>
    <!-- Colision simple: la malla de 160k caras no sirve para fisica -->
    <collision>
      <origin xyz="0 0 0.0769" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.1537"/>
      </geometry>
    </collision>
    <!-- Ruedas locas: esferas sin friccion -->
    <collision name="caster_front_collision">
      <origin xyz="${caster_x} 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <collision name="caster_rear_collision">
      <origin xyz="${-caster_x} 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>
  
  <!-- ===================== RUEDA IZQUIERDA ===================== -->
  <link name="wheel_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.016132"/>
      <inertia ixx="3.8963e-06" ixy="0" ixz="0"
               iyy="7.5952e-06" iyz="0" izz="3.8962e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/wheel_left.stl"/>
      </geometry>
      <material name="negro"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left"/>
    <origin xyz="0 ${wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <!-- ===================== RUEDA DERECHA ===================== -->
  <link name="wheel_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.016132"/>
      <inertia ixx="3.8963e-06" ixy="0" ixz="0"
               iyy="7.5952e-06" iyz="0" izz="3.8962e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/wheel_right.stl"/>
      </geometry>
      <material name="negro"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right"/>
    <origin xyz="0 ${-wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

</robot>