<?xml version="1.0" encoding="utf-8"?>
<!-- URDF creado por SolidWorks URDF Exporter y adaptado a ROS 2 / Gazebo Harmonic -->
<robot name="CLM-EnsambleColmibot">
  <link name="base_link">
    <inertial>
      <origin xyz="0.00041109 -0.0066161 0.037972" rpy="0 0 0" />
      <mass value="2.2668" />
      <inertia ixx="0.0013251" ixy="2.9877E-06" ixz="-9.5938E-07" iyy="0.0017147" iyz="1.544E-06" izz="0.0027926" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.69412 0.098039 0.098039 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0769" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.1537" />
      </geometry>
    </collision>
    <collision name="caster_front_collision">
      <origin xyz="0 0.08 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0135" />
      </geometry>
    </collision>
    <collision name="caster_rear_collision">
      <origin xyz="0 -0.08 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.0135" />
      </geometry>
    </collision>
  </link>
  <link name="LeftLink">
    <inertial>
      <origin xyz="-0.0078228 0 0" rpy="-3.1416 0 1.5708" />
      <mass value="0.019358" />
      <inertia ixx="4.6755E-06" ixy="1.0095E-15" ixz="-3.9645E-18" iyy="9.1143E-06" iyz="1.0881E-10" izz="4.6754E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="-3.1416 0 1.5708" />
      <geometry>
        <mesh filename="package://robot_description/meshes/LeftLink.STL" />
      </geometry>
      <material name="">
        <color rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.006 0 0" rpy="0 1.5707963 0" />
      <geometry>
        <cylinder radius="0.03" length="0.012" />
      </geometry>
    </collision>
  </link>
  <joint name="LeftW" type="continuous">
    <origin xyz="-0.081048 0 0.0165" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="LeftLink" />
    <axis xyz="-1 0 0" />
  </joint>
  <link name="RightWheel">
    <inertial>
      <origin xyz="0.0078228 0 0" rpy="3.1416 0 -1.5708" />
      <mass value="0.019358" />
      <inertia ixx="4.6755E-06" ixy="1.0097E-15" ixz="-4.6805E-18" iyy="9.1143E-06" iyz="1.0881E-10" izz="4.6754E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="3.1416 0 -1.5708" />
      <geometry>
        <mesh filename="package://robot_description/meshes/RightWheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.006 0 0" rpy="0 1.5707963 0" />
      <geometry>
        <cylinder radius="0.03" length="0.012" />
      </geometry>
    </collision>
  </link>
  <joint name="RightW" type="continuous">
    <origin xyz="0.081048 0 0.0165" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RightWheel" />
    <axis xyz="-1 0 0" />
  </joint>
  <gazebo reference="LeftLink">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="RightWheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>LeftW</left_joint>
      <right_joint>RightW</right_joint>
      <wheel_separation>0.174</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>LeftW</joint_name>
      <joint_name>RightW</joint_name>
    </plugin>
  </gazebo>
</robot>